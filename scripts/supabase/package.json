{
  "name": "craft-of-love-supabase-migration",
  "private": true,
  "type": "module",
  "scripts": {
    "dry-run": "node --env-file=.env migrate-firestore.mjs",
    "migrate": "node --env-file=.env migrate-firestore.mjs --apply",
    "auth-dry-run": "node --env-file=.env provision-auth-users.mjs",
    "auth-migrate": "node --env-file=.env provision-auth-users.mjs --apply",
    "admin-dry-run": "node --env-file=.env provision-admin.mjs",
